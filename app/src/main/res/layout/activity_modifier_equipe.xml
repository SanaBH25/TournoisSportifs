<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/lblTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/titre_modifier_equipe"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/txtNomEquipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nom_equipe"
        android:inputType="text" />

    <EditText
        android:id="@+id/txtSport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_sport"
        android:inputType="text" />

    <EditText
        android:id="@+id/txtSaison"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_saison"
        android:inputType="text" />

    <Button
        android:id="@+id/btnEnregistrer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="enregistrer"
        android:text="@string/btn_enregistrer" />

    <Button
        android:id="@+id/btnVoirJoueurs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="ouvrirJoueurs"
        android:text="@string/btn_voir_joueurs" />

    <Button
        android:id="@+id/btnSupprimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="supprimer"
        android:text="@string/btn_supprimer" />

    <Button
        android:id="@+id/btnRetour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="onretour"
        android:text="@string/btn_retour" />

</LinearLayout>
