<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/lblTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/titre_creer_equipe"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/txtNomEquipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nom_equipe"
        android:inputType="text" />

    <EditText
        android:id="@+id/txtSport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_sport"
        android:inputType="text" />

    <Button
        android:id="@+id/btnCreerEquipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="creer"
        android:text="@string/btn_creer_equipe" />

    <Button
        android:id="@+id/btnRetour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="onretour"
        android:text="@string/btn_retour" />

</LinearLayout>
