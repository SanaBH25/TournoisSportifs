<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TournoisSportifs"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ConnexionActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InscriptionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChoixEquipeActivity"
            android:exported="false" />

        <activity
            android:name=".CreerEquipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MesEquipesActivity"
            android:exported="false" />
        <activity
            android:name=".MenuAdminActivity"
            android:exported="false" />

        <activity
            android:name=".MenuParentActivity"
            android:exported="false" />

        <activity
            android:name=".ModifierEquipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MesEnfantsActivity"
            android:exported="false" />

        <activity
            android:name=".AjouterEnfantActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EquipesEnfantActivity"
            android:exported="false" />

        <activity
            android:name=".JoueursEquipeActivity"
            android:exported="false" />
    </application>

</manifest>